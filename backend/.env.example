APP_NAME="VenueDesk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=venuedesk
DB_USERNAME=venuedesk
DB_PASSWORD=
# Shared storage required for MFA replay controls across workers.
CACHE_STORE=database
CACHE_PREFIX=venuedesk
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Local development only: configure verified SMTP/API mailer before rollout.
MAIL_MAILER=log
