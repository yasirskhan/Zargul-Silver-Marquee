# Template only. Use separate protected central service and PostgreSQL database.
# Do not put production tokens, signing secrets or customer credentials in Git.
CENTRAL_API_ENABLED=false
CENTRAL_DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=hafzatech_central"
CENTRAL_DB_USERNAME=hafzatech_central
CENTRAL_DB_PASSWORD=
# Trusted vendor host is https://lichall.hafzatech.com (DNS/HTTPS not yet deployed).

# Protected isolated signer worker only. Must remain OFF until operator keys,
# independent actor MFA, settlement controls, sealed vault and backups are ready.
CENTRAL_SIGNER_FINALIZATION_ENABLED=false
