# Template only. Use separate protected central service and PostgreSQL database.
# Do not put production tokens, signing secrets or customer credentials in Git.
CENTRAL_API_ENABLED=false
# Independently disabled INTERNAL staff form/kernel composition. This flag
# alone must NEVER expose a route: trusted TLS, vault-backed MFA, HMAC secrets,
# audited recovery, safe cookie emitter and operator approval are still required.
CENTRAL_STAFF_PORTAL_ENABLED=false
# Independent final response-emission guard. Never set true before a trusted
# HTTPS vhost, protected operator secret manager and complete release signoff.
CENTRAL_STAFF_RESPONSE_EMITTER_ENABLED=false
CENTRAL_DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=hafzatech_central"
CENTRAL_DB_USERNAME=hafzatech_central
CENTRAL_DB_PASSWORD=
# Trusted vendor host is https://lichall.hafzatech.com (DNS/HTTPS not yet deployed).

# Protected isolated signer worker only. Must remain OFF until operator keys,
# independent actor MFA, settlement controls, sealed vault and backups are ready.
CENTRAL_SIGNER_FINALIZATION_ENABLED=false

# Separately protected, default-OFF grant readback. Requires operator vault
# decryption and authenticated installation request proof before deployment.
CENTRAL_GRANT_DELIVERY_ENABLED=false

# Separate protected KMS signing worker only, not central/public.
CENTRAL_SIGNED_DELIVERY_ENABLED=false

# Central support receiver is independent of license/paid renewal and OFF until secured
CENTRAL_SUPPORT_INGRESS_ENABLED=false

# Staff reply API and secure vendor MFA session not released
CENTRAL_SUPPORT_STAFF_REPLY_ENABLED=false

# Signed support-reply cursor transport is not public/live
CENTRAL_SUPPORT_PULL_ENABLED=false
